{
  "StoryEntryRouter": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": ["StoryCutscene", "StorySelectLatestStage", "StoryInsideRouter"]
  },
  "StorySelectLatestStage": {
    "recognition": "TemplateMatch",
    "template": ["story_stage_battle_icon.png", "story_stage_dialogue_icon.png"],
    "roi": [80, 120, 820, 430],
    "threshold": 0.78,
    "order_by": "Horizontal",
    "index": -1,
    "action": "Click",
    "target": true,
    "post_delay": 1800,
    "next": ["StoryCutscene", "StoryEnterSelectedStage", "StoryInsideRouter"]
  },
  "StoryEnterSelectedStage": {
    "recognition": "TemplateMatch",
    "template": "story_stage_battle.png",
    "roi": [660, 540, 300, 140],
    "threshold": 0.55,
    "action": "Click",
    "target": true,
    "post_delay": 1800,
    "next": ["StoryCutscene", "StoryFormation", "StoryInsideRouter"]
  },
  "StoryInsideRouter": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 350,
    "next": ["StoryCutscene", "StoryFormation", "StoryArtifact", "StoryShop", "StoryChoicePage", "StoryBattleWarning", "StoryFinishInvestigation"]
  },
  "StoryCutscene": {
    "recognition": "And",
    "all_of": [
      {"recognition": "TemplateMatch", "template": "story_play_anchor.png", "roi": [1080, 5, 82, 82], "threshold": 0.70, "method": 10001},
      {"recognition": "TemplateMatch", "template": "story_skip_live.png", "roi": [1170, 5, 84, 82], "threshold": 0.68, "method": 10001}
    ],
    "box_index": 1,
    "action": "Click",
    "target": [1196, 32, 28, 38],
    "post_delay": 900,
    "next": ["StorySkipConfirm", "StoryInsideRouter"]
  },
  "StorySkipConfirm": {
    "recognition": "DirectHit",
    "action": "Click",
    "target": [760, 480, 80, 45],
    "post_delay": 1300,
    "next": ["StoryCutscene", "StoryInsideRouter"]
  },
  "StoryFormation": {
    "recognition": "TemplateMatch",
    "template": "investigate.png",
    "roi": [940, 600, 290, 115],
    "threshold": 0.46,
    "action": "Click",
    "target": true,
    "post_delay": 2200,
    "next": ["StoryCutscene", "StoryBattleWarning", "StoryHideCards", "StoryAutoStart"]
  },
  "StoryBattleWarning": {
    "recognition": "TemplateMatch",
    "template": "battle_warning.png",
    "roi": [450, 180, 360, 210],
    "threshold": 0.62,
    "action": "DoNothing",
    "post_delay": 4500,
    "next": ["StoryCutscene", "StoryHideCards", "StoryAutoStart"]
  },
  "StoryHideCards": {
    "recognition": "TemplateMatch",
    "template": "hide_cards.png",
    "roi": [1100, 535, 150, 115],
    "threshold": 0.50,
    "action": "Click",
    "target_offset": [52, 38, -104, -76],
    "post_delay": 900,
    "next": ["StoryAutoStart"]
  },
  "StoryAutoStart": {
    "recognition": "TemplateMatch",
    "template": "speed.png",
    "roi": [105, 615, 90, 90],
    "threshold": 0.68,
    "method": 10001,
    "action": "Click",
    "target": [140, 650, 16, 16],
    "post_delay": 1200,
    "next": ["StoryMotionFrame1"]
  },
  "StoryMotionFrame1": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "capture1", "{IMAGE}", "story", "0.0025"],
    "post_delay": 1500, "next": ["StoryMotionFrame2"]
  },
  "StoryMotionFrame2": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "capture2", "{IMAGE}", "story", "0.0025"],
    "post_delay": 1500, "next": ["StoryMotionFrame3Compare"]
  },
  "StoryMotionFrame3Compare": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "compare", "{IMAGE}", "story", "0.0025"],
    "next": ["StoryBattleMonitor"], "on_error": ["StoryAutoRecoveryClick"]
  },
  "StoryAutoRecoveryClick": {
    "recognition": "TemplateMatch", "template": "speed.png", "roi": [105, 615, 90, 90], "threshold": 0.64, "method": 10001,
    "action": "Click", "target": [140, 650, 16, 16],
    "post_delay": 1200, "next": ["StoryRecoveryFrame1"]
  },
  "StoryRecoveryFrame1": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "capture1", "{IMAGE}", "story_recovery", "0.0025"],
    "post_delay": 1500, "next": ["StoryRecoveryFrame2"]
  },
  "StoryRecoveryFrame2": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "capture2", "{IMAGE}", "story_recovery", "0.0025"],
    "post_delay": 1500, "next": ["StoryRecoveryFrame3Compare"]
  },
  "StoryRecoveryFrame3Compare": {
    "recognition": "DirectHit", "action": "Command", "exec": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{RESOURCE_DIR}/scripts/frame_motion.ps1", "compare", "{IMAGE}", "story_recovery", "0.0025"],
    "next": ["StoryBattleMonitor"], "on_error": ["StoryStop"]
  },
  "StoryBattleMonitor": {
    "recognition": "DirectHit", "action": "DoNothing", "post_delay": 1000,
    "timeout": 300000,
    "next": ["StoryCutscene", "StoryFinishInvestigation", "StoryArtifact", "StoryShop", "StoryChoicePage"]
  },
  "StoryArtifact": {
    "recognition": "TemplateMatch", "template": "story_artifact_header.png", "roi": [0, 0, 500, 150], "threshold": 0.55,
    "action": "Click", "target": [390, 500, 25, 25], "post_delay": 1000, "next": ["StoryInsideRouter"]
  },
  "StoryShop": {
    "recognition": "TemplateMatch", "template": "story_shop_header.png", "roi": [0, 0, 500, 150], "threshold": 0.55,
    "action": "Click", "target": [400, 420, 25, 25], "post_delay": 800, "next": ["StoryShopClose"]
  },
  "StoryShopClose": {
    "recognition": "TemplateMatch", "template": "story_shop_close.png", "roi": [1100, 0, 180, 130], "threshold": 0.55,
    "action": "Click", "target": true, "post_delay": 900, "next": ["StoryInsideRouter"]
  },
  "StoryChoicePage": {
    "recognition": "TemplateMatch", "template": "story_choice_marker.png", "roi": [80, 260, 1120, 400], "threshold": 0.58,
    "action": "Click", "target": true, "post_delay": 900, "next": ["StoryInsideRouter"]
  },
  "StoryFinishInvestigation": {
    "recognition": "TemplateMatch", "template": "result_title.png", "roi": [820, 0, 434, 210], "threshold": 0.50,
    "action": "DoNothing", "next": ["StoryFinishCurrent", "StoryFinishAlt"]
  },
  "StoryFinishCurrent": {
    "recognition": "TemplateMatch", "template": "finish_current.png", "roi": [940, 590, 310, 125], "threshold": 0.48,
    "action": "Click", "target": true, "post_delay": 1800, "next": ["StoryEntryRouter"]
  },
  "StoryFinishAlt": {
    "recognition": "TemplateMatch", "template": "finish_alt.png", "roi": [940, 590, 310, 125], "threshold": 0.44,
    "action": "Click", "target": true, "post_delay": 1800, "next": ["StoryEntryRouter"]
  },
  "StoryStop": {"recognition": "DirectHit", "action": "StopTask", "next": []}
}
